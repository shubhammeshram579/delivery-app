# ============================================================
# DELIVERY APP — PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual production secrets.
# NEVER commit .env to version control!
# ============================================================

# ---- General / Deployment -----------------------------------
NODE_ENV=production
PORT=5000
# Update with your domain or server IP (e.g., https://yourdomain.com)
CLIENT_URL=https://yourdomain.com

# ---- PostgreSQL Container Config -----------------------------
# Used by both the postgres container and the server's DATABASE_URL connection
POSTGRES_DB=delivery_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password_here

# ---- Redis Container Config ----------------------------------
# Required for secure Redis setup
REDIS_PASSWORD=your_strong_redis_password_here

# ---- Next.js Client Build Arguments --------------------------
# Passed to Docker build for static Next.js frontend bundles
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- JWT Authentication --------------------------------------
JWT_SECRET=generate_a_random_string_at_least_64_characters_long_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate_another_distinct_random_64_char_string_here
JWT_REFRESH_EXPIRES_IN=30d

# ---- Razorpay Payment Gateway -------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- Google Maps API -----------------------------------------
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary (Media & Asset Storage) ----------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Nodemailer / SMTP ---------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Delivery App <noreply@deliveryapp.com>"

# ---- Twilio (SMS / OTP Verification) -------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ---- Rate Limiting & App Behavior ---------------------------
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100            # Max requests per window

# ---- Logging -------------------------------------------------
LOG_LEVEL=info                # error | warn | info | debug